# ─── Host Repository Mount ────────────────────────────────────────────────────
# Path on the host that Docker mounts as /workspace inside containers.
# The scanner uses /workspace to access target repositories.
# Use forward slashes on Windows (e.g. C:/Users/yourname, not C:\Users\yourname).
HOST_REPOS_PATH=/path/to/your/repos

# ─── Database ──────────────────────────────────────────────────────────────────
# For local development (without Docker): connect to your local PostgreSQL.
# Via Docker Compose: DATABASE_URL is overridden by docker-compose.yml.
# Host access to the Docker-managed DB: postgresql://...@localhost:5433/control_tower_db
DATABASE_URL=postgresql://control_tower:control_tower_pass@localhost:5432/control_tower_db

POSTGRES_USER=control_tower
POSTGRES_PASSWORD=control_tower_pass
POSTGRES_DB=control_tower_db

# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI Project Control Tower
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# ─── Scanner ───────────────────────────────────────────────────────────────────
# Comma-separated or JSON list of absolute paths the scanner is allowed to read.
# Example (comma): ALLOWED_SCAN_PATHS=/home/user/projects,/opt/repos
# Example (JSON):  ALLOWED_SCAN_PATHS=["/home/user/projects","/opt/repos"]
ALLOWED_SCAN_PATHS=

# Maximum file size in bytes the scanner will read (default: 1 MB).
MAX_SCAN_FILE_SIZE_BYTES=1048576

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated or JSON list of allowed origins for the FastAPI CORS middleware.
# Default (Docker Compose): Streamlit UI at localhost:8513 and Grafana at localhost:3012.
# CORS_ALLOWED_ORIGINS=http://localhost:8513,http://localhost:3012

# ─── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to start the Streamlit UI in demo mode by default (no backend required).
# Can also be toggled from the sidebar in the Streamlit UI.
DEMO_MODE=false

# ─── Observability ─────────────────────────────────────────────────────────────
# Grafana admin password (used by docker-compose).
GRAFANA_ADMIN_PASSWORD=admin

# ─── LLM Providers (optional) ──────────────────────────────────────────────────
# Agents fall back to deterministic pattern-based stubs if no key is set.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
